pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonar-token')
        DOCKER_CREDENTIALS = credentials('dockerhub')
        IMAGE_NAME = "anshyaa03/devops-project:${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/anshya03/devops_project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'pip install -r "ITS Project\\backend\\requirements.txt"'
            }
        }

        /*
        stage('SonarCloud Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('sonarqube') {
                        bat """
                        "${scannerHome}\\bin\\sonar-scanner.bat" ^
                        -Dsonar.projectKey=anshya03_devops_project ^
                        -Dsonar.organization=anshya03 ^
                        -Dsonar.sources=. ^
                        -Dsonar.host.url=https://sonarcloud.io ^
                        -Dsonar.token=%SONAR_TOKEN%
                        """
                    }
                }
            }
        }
        */

        stage('Trivy Filesystem Scan') {
            steps {
                bat 'trivy fs --exit-code 0 . > trivy-report.txt'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t %IMAGE_NAME% "ITS Project"'
            }
        }

        stage('Docker Push') {
            steps {
                bat '''
                echo %DOCKER_CREDENTIALS_PSW% | docker login -u %DOCKER_CREDENTIALS_USR% --password-stdin
                docker push %IMAGE_NAME%
                '''
            }
        }

        stage('Deploy to Render') {
            steps {
                withCredentials([string(credentialsId: 'render-deploy-hook', variable: 'RENDER_HOOK')]) {
                    bat 'curl -X POST %RENDER_HOOK%'
                }
            }
        }

        stage('Deploy Frontend to Netlify') {
            steps {
                withCredentials([string(credentialsId: 'netlify-build-hook', variable: 'NETLIFY_HOOK')]) {
                    bat 'curl -X POST %NETLIFY_HOOK%'
                }
            }
        }
    }
}