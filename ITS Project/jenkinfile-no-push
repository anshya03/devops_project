pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonar-token')
        IMAGE_NAME = "anshya03/its-project:${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/anshya03/devops_project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'pip install -r "ITS Project\\backend\\requirements.txt"'
                bat 'python -m pip install bandit'
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('sonarqube') {
                        bat """
                        "${scannerHome}\\bin\\sonar-scanner.bat" ^
                        -Dsonar.projectKey=anshya03_devops_project ^
                        -Dsonar.organization=anshya03 ^
                        -Dsonar.sources=. ^
                        -Dsonar.host.url=https://sonarcloud.io ^
                        -Dsonar.token=%SONAR_TOKEN%
                        """
                    }
                }
            }
        }

        stage('Bandit Vulnerability Scan') {
            steps {
                bat 'bandit -r "ITS Project\\backend" -f txt -o bandit-report.txt'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker build -t %IMAGE_NAME% .'
            }
        }

        stage('Run Container') {
            steps {
                bat '''
                docker rm -f its-container
                docker run -d -p 5000:5000 --name its-container %IMAGE_NAME%
                '''
            }
        }
    }
}